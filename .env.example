# Database configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://user:password@host:port/dbname

# AI Models & Speech APIs
GEMINI_API_KEY=your_gemini_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=InterviewPilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Supabase Auth & Storage Config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Payment & Subscription Configuration
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Stripe Configuration (Alternative provider)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRO_PRICE_ID=price_mock_pro

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Agent Evaluation Service (Optional)
AGENTEVAL_API_URL=http://127.0.0.1:8001
AGENTEVAL_API_KEY=your_agenteval_api_key
